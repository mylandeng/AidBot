# Image names. Replace with your company's registry addresses before pushing.
BACKEND_IMAGE=ghcr.io/mylandeng/aidbot-backend:latest
FRONTEND_IMAGE=ghcr.io/mylandeng/aidbot-frontend:latest

# Public ports on the deployment host.
BACKEND_PORT=8010
FRONTEND_PORT=3010

APP_NAME=AidBot
APP_ENV=production

# Must be a long random value. Never use the development default.
AUTH_SECRET_KEY=replace-with-a-long-random-secret
AUTH_TOKEN_TTL_SECONDS=28800
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=replace-with-a-strong-password
SEED_ADMIN_NAME=售后管理员

# Use the public frontend origin(s), separated by commas.
BACKEND_CORS_ORIGINS=https://aidbot.example.com

# For the bundled pgvector container, keep the host as db.
# For a managed PostgreSQL service, replace the whole URL with its connection string.
POSTGRES_DB=aidbot
POSTGRES_USER=aidbot
POSTGRES_PASSWORD=replace-with-a-database-password
DATABASE_URL=postgresql+psycopg://aidbot:replace-with-a-database-password@db:5432/aidbot

# The browser needs the public backend URL. The frontend container writes it to runtime-config.js on startup.
NEXT_PUBLIC_API_BASE_URL=https://api-aidbot.example.com
# Server-side Next.js requests use the Compose service name.
API_INTERNAL_BASE_URL=http://backend:8010

# LLM provider: local, deepseek, or openai_compatible.
LLM_PROVIDER=local
LLM_MODEL=aidbot-local-v1
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_TIMEOUT_SECONDS=60

# Embedding provider: hash or openai_compatible.
EMBEDDING_PROVIDER=hash
EMBEDDING_MODEL=
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=
EMBEDDING_DIMENSIONS=96
EMBEDDING_TIMEOUT_SECONDS=30

LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=aidbot-prod
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
