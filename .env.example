APP_NAME=AidBot
APP_ENV=development
API_HOST=0.0.0.0
API_PORT=8010
BACKEND_CORS_ORIGINS=http://localhost:3010,http://127.0.0.1:3010
AUTH_SECRET_KEY=change-this-dev-secret
AUTH_TOKEN_TTL_SECONDS=28800
SEED_ADMIN_EMAIL=admin@aidbot.local
SEED_ADMIN_PASSWORD=aidbot123
SEED_ADMIN_NAME=售后管理员
# LLM provider:
# - local: deterministic development fallback; does not call an external LLM even if LLM_API_KEY is set.
# - deepseek/openai_compatible: calls LLM_BASE_URL using the OpenAI-compatible chat completions API.
# After changing LLM_* values in .env, recreate backend: docker compose up -d --force-recreate backend
LLM_PROVIDER=local
# Use aidbot-local-v1 with LLM_PROVIDER=local. For DeepSeek, use deepseek-chat unless another model is intended.
LLM_MODEL=aidbot-local-v1
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_TIMEOUT_SECONDS=60

# Embedding branch database:
# Use a separate database from main so schema migrations, pgvector setup, and reindexing
# can be tested without changing the stable aidbot database used by main.
POSTGRES_DB=aidbot_embedding_dev
POSTGRES_USER=aidbot
POSTGRES_PASSWORD=aidbot_dev_password
DATABASE_URL=postgresql+psycopg://aidbot:aidbot_dev_password@db:5432/aidbot_embedding_dev

# Embedding provider:
# - hash: existing deterministic local fallback; no external embedding model.
# - openai_compatible: calls EMBEDDING_BASE_URL using an OpenAI-compatible embeddings API.
EMBEDDING_PROVIDER=hash
EMBEDDING_MODEL=
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=
EMBEDDING_DIMENSIONS=96
EMBEDDING_TIMEOUT_SECONDS=30

API_INTERNAL_BASE_URL=http://backend:8010
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8010

#langsmith trace
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=aidbot-dev
# Default US endpoint. Override for EU/APAC/AWS regions or self-hosted LangSmith.
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
